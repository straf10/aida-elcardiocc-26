#!/bin/sh
# Μπλοκάρει commits στο main/master (τοπικά). Παράκαμψη μόνο αν ξέρεις τι κάνεις: git commit --no-verify
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo ""
  echo "⛔ Δεν επιτρέπεται commit στο «$branch»."
  echo "   Κάνε checkout σε branch δουλειάς: python3 setup-scripts/2-git-start-task.py feature/χρήστης/όνομα-task"
  echo ""
  exit 1
fi
exit 0
